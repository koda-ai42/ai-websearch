AI_WEBSEARCH_MCP_HOST=127.0.0.1
AI_WEBSEARCH_MCP_PORT=8050
# answer (default), diagnostic, or admin. Prefer `serve --toolset` for temporary elevation.
AI_WEBSEARCH_MCP_TOOLSET=answer
AI_WEBSEARCH_SEARXNG_URL=http://127.0.0.1:8888
AI_WEBSEARCH_SEARXNG_TIMEOUT_SECONDS=15
AI_WEBSEARCH_SEARXNG_SETTINGS_PATH=./searxng/settings.yml
AI_WEBSEARCH_DATABASE_PATH=./data/ai_websearch.sqlite3
AI_WEBSEARCH_DATABASE_BUSY_TIMEOUT_SECONDS=5

AI_WEBSEARCH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_WEBSEARCH_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
AI_WEBSEARCH_EMBEDDING_DEVICE=auto
AI_WEBSEARCH_EMBEDDING_BATCH_SIZE=32
AI_WEBSEARCH_EMBEDDING_CACHE_FOLDER=

# off, heuristic or cross_encoder. Changing mode requires a server restart.
AI_WEBSEARCH_RERANKING_MODE=cross_encoder
AI_WEBSEARCH_RERANKING_MODEL=cross-encoder/ettin-reranker-17m-v1
AI_WEBSEARCH_RERANKING_MODEL_REVISION=9e4aa35321a6dd1a43ca313f500c4b4f7cfb5cc6
AI_WEBSEARCH_RERANKING_DEVICE=auto
AI_WEBSEARCH_RERANKING_BATCH_SIZE=16
AI_WEBSEARCH_RERANKING_MAX_LENGTH=768
AI_WEBSEARCH_RERANKING_CANDIDATES=24
AI_WEBSEARCH_RERANKING_CACHE_FOLDER=

AI_WEBSEARCH_SCRAPE_TIMEOUT_SECONDS=35
AI_WEBSEARCH_MAX_CHARS_PER_PAGE=60000
AI_WEBSEARCH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) ai-websearch/0.1.0b1
AI_WEBSEARCH_CHUNK_SIZE_CHARS=1200
AI_WEBSEARCH_CHUNK_OVERLAP_CHARS=180
AI_WEBSEARCH_MIN_CHUNK_CHARS=180
AI_WEBSEARCH_VECTOR_WEIGHT=0.70
AI_WEBSEARCH_KEYWORD_WEIGHT=0.30

# auto or manual. Auto inspects llama-server processes; it does not scan ports.
AI_WEBSEARCH_LLAMA_CPP_DETECTION_MODE=auto
# Required only in manual mode. llama-server normally uses port 8080 and may include an API prefix.
AI_WEBSEARCH_LLAMA_CPP_BASE_URL=
AI_WEBSEARCH_LLAMA_CPP_API_KEY=
AI_WEBSEARCH_LLAMA_CPP_MODEL=
AI_WEBSEARCH_LLAMA_CPP_DETECTION_CACHE_SECONDS=300
AI_WEBSEARCH_LLAMA_CPP_REQUEST_TIMEOUT_SECONDS=5
AI_WEBSEARCH_LLAMA_CPP_PROCESS_INSPECTION_TIMEOUT_SECONDS=3

AI_WEBSEARCH_MAX_WEB_CONTEXT_RATIO=0.60
AI_WEBSEARCH_RESERVED_OUTPUT_TOKENS=4096
AI_WEBSEARCH_RESERVED_SYSTEM_TOOL_TOKENS=4096
AI_WEBSEARCH_RESERVED_HISTORY_TOKENS=8192
AI_WEBSEARCH_CONTEXT_SAFETY_MARGIN_TOKENS=2048
AI_WEBSEARCH_DEFAULT_RESEARCH_MODE=auto
AI_WEBSEARCH_DEFAULT_CONTEXT_MODE=balanced
AI_WEBSEARCH_RAPID_RESEARCH_MAX_SECONDS=60
AI_WEBSEARCH_DEEP_RESEARCH_MAX_SECONDS=240
# Absolute safety ceiling; mode defaults are rapid=2, auto=5, deep=10.
AI_WEBSEARCH_RESEARCH_MAX_PAGE_ATTEMPTS_HARD_LIMIT=20
AI_WEBSEARCH_LLAMA_CPP_LOCAL_ONLY=true

# Bounded request pacing. Limits are applied independently per destination domain.
AI_WEBSEARCH_SEARCH_CONCURRENCY=2
AI_WEBSEARCH_SEARCH_MIN_INTERVAL_SECONDS=0.5
AI_WEBSEARCH_CRAWL_DOMAIN_CONCURRENCY=1
AI_WEBSEARCH_CRAWL_MIN_INTERVAL_SECONDS=2.0
AI_WEBSEARCH_MAX_RETRIES=3
AI_WEBSEARCH_RETRY_BACKOFF_SECONDS=1.0
AI_WEBSEARCH_CACHE_TTL_HOURS=24
